<?xml version="1.0" encoding="utf-8"?>
<!-- Android 6 to 11 full backup. allowBackup is false, so this only documents the exclusion. -->
<full-backup-content>
    <exclude domain="file" path="datastore/" />
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
</full-backup-content>
