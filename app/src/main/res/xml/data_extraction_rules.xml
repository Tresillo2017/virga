<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (cloud backup and device-to-device transfer). allowBackup=false already blocks backup on
  every version; these rules also stop the credential and session stores moving to a new device.
  Keep this list in step with every DataStore name in the app (see docs/feature-module-guide.md).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
