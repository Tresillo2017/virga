<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher foreground: mark A (three slanted streaks on a 100x100 grid), scaled to 0.62 and centred
  inside the 66dp adaptive-icon safe zone of the 108dp canvas. Gradients follow the dark brand palette
  (#9DB8FF, #8E9BFF, transparent). Keep in step with core/ui VirgaMarkGeometry.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="23.62"
        android:translateY="21.76"
        android:scaleX="0.62"
        android:scaleY="0.62">
        <path
            android:pathData="M34,16 L20,70"
            android:strokeLineCap="round"
            android:strokeWidth="11">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="0" android:startY="16"
                    android:endX="0" android:endY="70"
                    android:startColor="#FF9DB8FF"
                    android:centerColor="#FF8E9BFF"
                    android:endColor="#00000000" />
            </aapt:attr>
        </path>
        <path
            android:pathData="M56,16 L38,88"
            android:strokeLineCap="round"
            android:strokeWidth="11">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="0" android:startY="16"
                    android:endX="0" android:endY="88"
                    android:startColor="#FF9DB8FF"
                    android:centerColor="#FF8E9BFF"
                    android:endColor="#00000000" />
            </aapt:attr>
        </path>
        <path
            android:pathData="M78,16 L66,62"
            android:strokeLineCap="round"
            android:strokeWidth="11">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="0" android:startY="16"
                    android:endX="0" android:endY="62"
                    android:startColor="#FF9DB8FF"
                    android:centerColor="#FF8E9BFF"
                    android:endColor="#00000000" />
            </aapt:attr>
        </path>
    </group>
</vector>
