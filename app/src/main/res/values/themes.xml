<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      System splash: the mark on the near-black background, held until the session has restored.
      Then the Compose AnimatedSplash runs once, and the app's own theme takes over.
    -->
    <style name="Theme.Virga.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0B0E14</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Virga</item>
    </style>

    <style name="Theme.Virga" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0B0E14</item>
    </style>
</resources>
