<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The module namespace is com.tomasps.virga, so component names must be fully qualified. -->
    <application
        android:name="com.tomasps.virga.wear.VirgaWearApp"
        android:allowBackup="false"
        android:label="Virga"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Placeholder launcher entry; replaced by the real UI in a later task. -->
        <activity
            android:name="com.tomasps.virga.wear.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="com.tomasps.virga.wear.session.HandoffListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:path="/virga/credential" />
            </intent-filter>
        </service>
    </application>

</manifest>
